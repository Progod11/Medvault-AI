"use client";

import { useEffect } from "react";
import Link from "next/link";
import { motion } from "framer-motion";
import { AlertTriangle, RefreshCw, LayoutDashboard, ShieldCheck, HeartPulse } from "lucide-react";

export default function Error({
  error,
  reset,
}: {
  error: Error & { digest?: string };
  reset: () => void;
}) {
  useEffect(() => {
    console.error("MedVault AI Application Error:", error);
  }, [error]);

  return (
    <div className="min-h-screen bg-background dark:bg-dark-bg text-foreground flex flex-col items-center justify-center p-4 relative overflow-hidden">
      <div className="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[450px] h-[450px] bg-warning/10 rounded-full blur-3xl pointer-events-none" />

      <div className="max-w-md w-full text-center space-y-6 relative z-10 card p-8 border-warning/30 shadow-card-lg bg-surface dark:bg-dark-surface">
        <motion.div
          initial={{ scale: 0.9, opacity: 0 }}
          animate={{ scale: 1, opacity: 1 }}
          className="w-16 h-16 rounded-2xl bg-warning/10 border border-warning/30 text-warning flex items-center justify-center mx-auto"
        >
          <AlertTriangle className="w-8 h-8" />
        </motion.div>

        <div className="space-y-2">
          <span className="text-xs font-bold uppercase tracking-widest text-warning bg-warning/10 px-3 py-1 rounded-full border border-warning/20">
            System Diagnostics Notice
          </span>
          <h2 className="font-heading font-extrabold text-2xl text-accent dark:text-white">
            Temporary System Interruption
          </h2>
          <p className="text-xs text-muted-foreground leading-relaxed">
            MedVault AI encountered an unexpected client runtime event. Your patient data and uploaded lab files remain encrypted and unharmed.
          </p>
        </div>

        {error?.message && (
          <div className="p-3 bg-background dark:bg-dark-bg rounded-xl border border-border dark:border-dark-border text-left font-mono text-[11px] text-muted-foreground overflow-x-auto max-h-24">
            <code>{error.message}</code>
          </div>
        )}

        <div className="flex flex-col sm:flex-row gap-3 pt-2">
          <button
            onClick={() => reset()}
            className="btn-primary flex-1 py-3 text-xs flex items-center justify-center gap-2 cursor-pointer shadow-glow"
          >
            <RefreshCw className="w-4 h-4" /> Reload Component
          </button>
          <Link href="/dashboard" className="flex-1">
            <button className="btn-outline w-full py-3 text-xs flex items-center justify-center gap-2 cursor-pointer">
              <LayoutDashboard className="w-4 h-4" /> Go to Dashboard
            </button>
          </Link>
        </div>

        <div className="pt-4 border-t border-border dark:border-dark-border flex items-center justify-center gap-2 text-[11px] text-muted-foreground">
          <ShieldCheck className="w-3.5 h-3.5 text-success" /> Encrypted Local & Cloud State Intact
        </div>
      </div>
    </div>
  );
}
